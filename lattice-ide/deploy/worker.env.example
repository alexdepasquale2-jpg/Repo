# Lattice worker environment -> /etc/lattice/worker.env (owner root, mode 0600).
# install.sh copies this file there only if it does not exist yet; edit that copy.
# Every value below is a placeholder. Never put a Hugging Face token in this file:
# HF tokens arrive per job as the X-HF-Token header and are never stored.

# --- Network ------------------------------------------------------------------
# Bind address. Keep 127.0.0.1 behind the reverse proxy (deploy/Caddyfile); only 443 is public.
LATTICE_HOST=127.0.0.1
# Port the worker listens on.
LATTICE_PORT=8787

# --- Storage ------------------------------------------------------------------
# Runs directory (inputs, artifacts, status.json). Must be inside the unit's ReadWritePaths.
LATTICE_RUNS=/var/lib/lattice/runs

# --- Execution ----------------------------------------------------------------
# 1 = force dry runs even when engines are installed. Leave empty for normal behavior.
LATTICE_DRY_RUN=
# 1 = run installed engines for real. Empty = every job is a dry run (stages + plan.json only).
LATTICE_EXEC=
# Engine commands. Empty = the bundled adapters (<worker python> adapters/<engine>/cli.py).
# When the engines live in their own Python envs (usual; see ENGINES.md), point at those:
#   LATTICE_COSMOS_CMD=/opt/cosmos-venv/bin/python /opt/lattice/adapters/cosmos/cli.py
#   LATTICE_HY_CMD=/opt/hy-env/bin/python /opt/lattice/adapters/hyworld/cli.py
LATTICE_COSMOS_CMD=
LATTICE_HY_CMD=
# Packages used to detect installed engines (in the worker's own Python).
# Defaults: diffusers (cosmos_framework with LATTICE_COSMOS_BACKEND=framework) and hyworld2.
# HY-World also counts as installed when LATTICE_HY_ROOT points at a checkout.
LATTICE_COSMOS_MODULE=
LATTICE_HY_MODULE=

# --- Engine adapters (read by adapters/*; see ENGINES.md) ----------------------
# JSON file overriding the Lattice model id -> upstream checkpoint map.
#LATTICE_MODEL_MAP=/etc/lattice/model-map.json
# Cosmos: diffusers (Cosmos3OmniPipeline) or framework (cosmos_framework inference script).
#LATTICE_COSMOS_BACKEND=diffusers
#LATTICE_COSMOS_FRAMEWORK_DIR=/opt/cosmos-framework
#LATTICE_COSMOS_GUARDRAILS=1
#LATTICE_COSMOS_OFFLOAD=0
#LATTICE_COSMOS_NPROC=1
#LATTICE_COSMOS_MAX_NEW_TOKENS=1024
#LATTICE_COSMOS_NEGATIVE_PROMPT=
# HY-World 2.0: checkout, its Python env, GPUs for torchrun stages, and the WorldNav VLM server.
#LATTICE_HY_ROOT=/opt/HY-World-2.0
#LATTICE_HY_PYTHON=/opt/hy-env/bin/python
#LATTICE_HY_PANO_PYTHON=
#LATTICE_HY_NPROC=1
#LATTICE_HY_LLM_ADDR=127.0.0.1
#LATTICE_HY_LLM_PORT=8000
#LATTICE_HY_LLM_NAME=
#LATTICE_HY_KEEP_WORK=0
#LATTICE_HY_SAVE_MAPS=0

# --- Auth ---------------------------------------------------------------------
# Shared bearer token (single-user mode). Generate one with: openssl rand -hex 32
# Required whenever the worker is reachable from anything but localhost. install.sh replaces
# this placeholder with a fresh random token when it first creates /etc/lattice/worker.env.
LATTICE_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32
# Optional multi-user mode (workers that support it): path to a users file holding only
# sha256 token hashes. When set it replaces LATTICE_TOKEN. The file is written 0600, so keep
# it owned by the service user, inside ReadWritePaths:
#   sudo -u lattice env LATTICE_USERS=/var/lib/lattice/users.json LATTICE_RUNS=/var/lib/lattice/runs \
#       python3 /opt/lattice/worker.py users add <name> --role operator
#LATTICE_USERS=/var/lib/lattice/users.json
# 1 = take the client IP for the audit log from X-Forwarded-For. Only safe when the worker is
# reachable solely through the reverse proxy (LATTICE_HOST=127.0.0.1, or the compose network).
LATTICE_TRUST_PROXY=1

# --- Licensing / territory ----------------------------------------------------
# ISO 3166 alpha-2 of the country this machine runs in. EU-27, GB or KR disables HY-World
# and Bridge jobs (HY-World 2.0 license does not apply there). REQUIRED: set it, e.g. US.
# Empty = gate off (a non-ISO value is also ignored with a warning).
LATTICE_REGION=

# --- Cost ---------------------------------------------------------------------
# Optional $/GPU-hour; enables metrics.cost_usd per job (an estimate, not a bill).
LATTICE_GPU_USD_HR=
