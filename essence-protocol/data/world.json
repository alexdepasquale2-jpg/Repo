  "text": {
    "guide": "Archivist Lo",
    "tutorial": [
      "{daemon}, a fine first daemon. It already knows its four basic merges.",
      "Walk into static, the flickering tiles, to meet wild daemons. Weaken one, then tap Bind to capture it.",
      "Head west to the Cirrus Array when you're ready. Its Warden holds the first key. Your Requests tab always has something to chase."
    ]
  }
}
