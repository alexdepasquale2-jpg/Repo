{
  "name": "skyneet-survivors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SkyNeet Survivors — every run changes the battlefield for the next run.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tool:blueprint-validator": "tsx tools/blueprint-validator/index.ts",
    "tool:campaign-graph-visualizer": "tsx tools/campaign-graph-visualizer/index.ts",
    "tool:noise-heatmap-generator": "tsx tools/noise-heatmap-generator/index.ts",
    "tool:feat-balance-simulator": "tsx tools/feat-balance-simulator/index.ts",
    "tool:localization-extractor": "tsx tools/localization-extractor/index.ts"
  },
  "dependencies": {
    "three": "^0.180.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.36.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
